# Testy e2e (Playwright) uruchamiane LOKALNIE, ale celujące w wdrożenie
# preview na Vercelu i jego bazę Supabase ("environment: preview").
# Skopiuj do .env.e2e i uzupełnij — ten plik nigdy nie trafia do gita.

# URL konkretnego (albo stałego) deploya preview z Vercela, np.:
# https://bmt-app-new-git-dev-<team>.vercel.app
E2E_BASE_URL=

# Jeśli projekt ma włączony Vercel Deployment Protection (SSO) na preview -
# Ustawienia projektu -> Deployment Protection -> Protection Bypass for
# Automation. Bez tego żądania trafiają na ekran logowania do Vercela.
VERCEL_PROTECTION_BYPASS_SECRET=

# Dane logowania testowego użytkownika (zwykłego konta w tej aplikacji) -
# NIE używaj tu swojego głównego konta produkcyjnego.
E2E_LOGIN_EMAIL=
E2E_LOGIN_PASSWORD=

# Ta sama baza Supabase, do której gada preview - Settings → API tego projektu
# Supabase (środowisko "preview", to co zwraca `npm run db:push:preview`).
# Service role key jest potrzebny, żeby testy mogły same zakładać/sprzątać
# dane testowe (najemców, umowy) z pominięciem UI.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
