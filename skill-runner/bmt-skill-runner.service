[Unit]
Description=BMT Skill Runner
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/bmt-app/skill-runner
ExecStart=/usr/bin/node /opt/bmt-app/skill-runner/server.js
Restart=always
RestartSec=5
Environment=NODE_ENV=production
EnvironmentFile=/opt/bmt-app/skill-runner/.env
EnvironmentFile=-/opt/bmt-app/skill-runner/secrets.env

[Install]
WantedBy=multi-user.target
