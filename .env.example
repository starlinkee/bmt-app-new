# ─── SUPABASE ────────────────────────────────────────────────────────────────
# supabase.com → projekt → Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Settings → Database → Connection string (tylko do skryptu db:push)
SUPABASE_DB_URL=

# ─── GOOGLE (Sheets + Drive) ──────────────────────────────────────────────────
# console.cloud.google.com → IAM → Konta usług → Utwórz klucz JSON
# BASE64 z pliku: [Convert]::ToBase64String([IO.File]::ReadAllBytes("klucz.json"))
GOOGLE_SERVICE_ACCOUNT_JSON=

# console.cloud.google.com → Dane uwierzytelniające → OAuth 2.0 (typ: Web)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=

# ─── APLIKACJA ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
