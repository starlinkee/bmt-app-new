{
  "name": "webapp-template",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "skill-runner"
  ],
  "scripts": {
    "dev:next": "next dev",
    "dev:skill": "npm run start -w skill-runner",
    "dev": "concurrently -c \"cyan,magenta\" -n \"next,skill\" \"npm run dev:next\" \"npm run dev:skill\"",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:types": "supabase gen types typescript --project-id aimxvcnyzraoacrbdsbz | Set-Content types/supabase.ts -Encoding utf8",
    "db:push": "dotenv -e .env.local -- cmd /c \"supabase db push --db-url %SUPABASE_DB_URL%\" && supabase gen types typescript --project-id aimxvcnyzraoacrbdsbz | Set-Content types/supabase.ts -Encoding utf8",
    "vercel:env": "tsx scripts/vercel-env-push.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@react-email/components": "^1.0.12",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.0",
    "@tanstack/react-query": "^5.99.0",
    "@types/nodemailer": "^8.0.0",
    "@types/papaparse": "^5.5.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "googleapis": "^171.4.0",
    "lucide-react": "^1.8.0",
    "next": "16.2.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^8.0.9",
    "papaparse": "^5.5.3",
    "pdfkit": "^0.20.2",
    "pdfkit-table": "^0.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.2.0",
    "sonner": "^2.0.7",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.5",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.3",
    "supabase": "^2.91.1",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^4.1.8"
  }
}
